# Banco Crion (Postgres externo). Nunca apontar para o HQ GEAP.
DATABASE_URL=postgres://usuario:senha@host:5432/hq_crion

# Origem do app web (CORS da API).
CORS_ORIGIN=https://hq.example.com

# URL pública da API, usada no build da imagem web (VITE_API_URL).
VITE_API_URL=https://api.hq.example.com

# Segredo de sessão em produção (assinatura futura da sessão).
SESSION_SECRET=troque-em-producao

# true pula os Atendimentos de demonstração. Perfil, Agente de Voz, Régua e a IA Avaliadora são semeados mesmo assim.
SKIP_SEED=false

# Ingestão mínima ElevenLabs (opcional). Sem chave, o HQ só lê o DB Crion.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Armazenamento de áudio (opcional). Sem bucket, a mídia fica na URL da fonte / caminho do HQ.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
